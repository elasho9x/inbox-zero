{
  "expo": {
    "name": "VINBOX",
    "slug": "vinbox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinbox.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "VINBOX needs camera access to scan QR codes for email setup",
        "NSPhotoLibraryUsageDescription": "VINBOX needs photo library access to attach images to emails"
      },
      "associatedDomains": [
        "applinks:vinbox.app"
      ]
    },
    "android": {
      "package": "com.vinbox.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A8A"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "vinbox",
            "host": "auth-callback"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.20"
          }
        }
      ],
      "expo-build-properties"
    ],
    "scheme": "vinbox",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "vinbox-mobile"
      }
    },
    "owner": "vinbox",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/vinbox-mobile",
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    }
  }
}