# Internal VINBOX deployment. Copy values into your private, untracked apps/web/.env.
NEXT_PUBLIC_BRAND_NAME=VINBOX
NEXT_PUBLIC_SLACK_BOT_NAME=VINBOX
# NEXT_PUBLIC_BRAND_LOGO_URL=/vinbox-logo.svg
# NEXT_PUBLIC_BRAND_ICON_URL=/vinbox-icon.png
# AUTH_ALLOWED_EMAILS=admin@example.com
# AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# Nylas is only for mail providers missing native support.
# Server-only credentials; configure the actual secrets in your environment.
NYLAS_API_KEY=
NYLAS_REGION=us
NYLAS_CLIENT_ID=
# Integrate these with apps/web/env.ts as the provider implementation is completed.
